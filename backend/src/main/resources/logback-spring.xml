<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ── Consola (toda la app, nivel INFO) ────────────────────────────── -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Archivo dedicado para IngestFixtures ─────────────────────────── -->
    <appender name="INGEST_FIXTURES_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/ingest-fixtures.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Un archivo por día, se conservan 30 días -->
            <fileNamePattern>logs/ingest-fixtures.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>200MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level — %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ── Logger específico de IngestFixtures → solo al archivo ────────── -->
    <logger name="com.playerdatatracking.operations.IndelxalData.IngestFixtures"
            level="INFO"
            additivity="false">
        <appender-ref ref="INGEST_FIXTURES_FILE"/>
    </logger>

    <!-- ── Root: consola para el resto de la app ────────────────────────── -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
