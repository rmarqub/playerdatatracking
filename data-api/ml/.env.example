# Variables de entorno para la configuración de la base de datos.
# Copia este archivo como .env y ajusta los valores.
# IMPORTANTE: Guarda este archivo en UTF-8. Usa solo caracteres ASCII
# en la contraseña (sin acentos, ñ, etc.) para evitar errores de psycopg2.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=playerdata
DB_USER=postgres
DB_PASSWORD=admin
